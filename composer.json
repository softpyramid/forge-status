{
    "name": "softpyramid/forge-status",
    "description": "Real-time Laravel Forge deployment status indicator via webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "forge", "deployment", "webhook", "status", "indicator", "real-time"],
    "authors": [
        {
            "name": "Fakhar Zaman Khan",
            "email": "fakhar@softpyramid.com",
            "homepage": "https://softpyramid.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Softpyramid\\ForgeStatus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softpyramid\\ForgeStatus\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Softpyramid\\ForgeStatus\\ForgeStatusServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
